<Window x:Class="Pompom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pompom"
        Width="410"
        Height="520"
        MinWidth="380"
        MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/Pompom.ico"
        Background="{DynamicResource PompomSurfaceBrush}"
        Foreground="{DynamicResource PompomTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="32,26,32,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="34"
                       Height="34"
                       Source="Assets/Pompom.ico" />
                <TextBlock Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="POMPOM" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    AutomationProperties.Name="Settings"
                    ToolTip="Settings"
                    Click="SettingsButton_Click">
                <Viewbox Width="18" Height="18" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3,6 L21,6 M3,12 L21,12 M3,18 L21,18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <Ellipse Canvas.Left="7"
                                 Canvas.Top="3"
                                 Width="6"
                                 Height="6"
                                 Fill="{DynamicResource PompomSurfaceBrush}"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 StrokeThickness="2" />
                        <Ellipse Canvas.Left="13"
                                 Canvas.Top="9"
                                 Width="6"
                                 Height="6"
                                 Fill="{DynamicResource PompomSurfaceBrush}"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 StrokeThickness="2" />
                        <Ellipse Canvas.Left="4"
                                 Canvas.Top="15"
                                 Width="6"
                                 Height="6"
                                 Fill="{DynamicResource PompomSurfaceBrush}"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 StrokeThickness="2" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="0,18,0,18"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            <Border HorizontalAlignment="Center"
                    Padding="13,6"
                    Background="{DynamicResource PompomAccentSoftBrush}"
                    CornerRadius="14">
                <TextBlock x:Name="SessionText"
                           Foreground="{DynamicResource PompomAccentBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="Focus" />
            </Border>

            <TextBlock x:Name="CountdownText"
                       Margin="0,20,0,0"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="92"
                       FontWeight="Light"
                       LineHeight="100"
                       Text="25:00" />

            <TextBlock x:Name="StatusText"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}"
                       FontSize="13"
                       Text="Ready" />

            <ProgressBar x:Name="SessionProgress"
                         Margin="20,24,20,0"
                         Minimum="0"
                         Maximum="1"
                         Style="{DynamicResource PompomProgressStyle}"
                         Value="0" />
            <TextBlock x:Name="CycleText"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource MutedTextStyle}"
                       FontSize="12"
                       Text="Pomodoro 1 of 4" />
        </StackPanel>

        <Grid Grid.Row="2" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Reset the current session (Ctrl+Alt+R)"
                    Click="ResetButton_Click"
                    Content="Reset" />

            <Grid Grid.Column="1">
                <Button x:Name="StartButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Start or resume (Ctrl+Alt+P)"
                        Click="StartButton_Click"
                        Content="Start" />
                <Button x:Name="StopButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Stop and keep the remaining time (Ctrl+Alt+X)"
                        Click="StopButton_Click"
                        Content="Stop"
                        Visibility="Collapsed" />
            </Grid>

            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    ToolTip="Skip to the next session (Ctrl+Alt+N)"
                    Click="SkipButton_Click"
                    Content="Skip" />
        </Grid>
    </Grid>
</Window>
