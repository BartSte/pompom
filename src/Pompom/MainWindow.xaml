<Window x:Class="Pompom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pompom"
        Width="390"
        Height="500"
        MinWidth="350"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/Pompom.ico"
        Background="{StaticResource PompomSurfaceBrush}"
        Foreground="{StaticResource PompomTextBrush}">
    <Grid Margin="28,22,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="30" Height="30" Source="Assets/Pompom.ico" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PompomTextBrush}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="Pompom" />
            </StackPanel>
            <Button Grid.Column="1"
                    Width="38"
                    Height="38"
                    Padding="0"
                    ToolTip="Settings"
                    Click="SettingsButton_Click">
                <TextBlock FontFamily="Segoe Fluent Icons"
                           Foreground="{StaticResource PompomTextBrush}"
                           FontSize="17"
                           Text="&#xE713;" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="0,36,0,26"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            <TextBlock x:Name="SessionText"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource PompomTextBrush}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Text="Focus" />
            <TextBlock x:Name="CycleText"
                       Margin="0,5,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource PompomTextBrush}"
                       Opacity="0.65"
                       Text="Pomodoro 1 of 4" />

            <TextBlock x:Name="CountdownText"
                       Margin="0,20,0,17"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource PompomTextBrush}"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="76"
                       FontWeight="Light"
                       Text="25:00" />

            <ProgressBar x:Name="SessionProgress"
                         Height="6"
                         Minimum="0"
                         Maximum="1"
                         Value="0" />
            <TextBlock x:Name="StatusText"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource PompomTextBrush}"
                       FontSize="13"
                       Opacity="0.65"
                       Text="Ready" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton"
                        Grid.Column="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Start or resume (Ctrl+Alt+P)"
                        Click="StartButton_Click"
                        Content="Start" />
                <Button x:Name="StopButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Stop and keep the remaining time (Ctrl+Alt+X)"
                        Click="StopButton_Click"
                        Content="Stop" />
                <Button Grid.Column="4"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Skip to the next session (Ctrl+Alt+N)"
                        Click="SkipButton_Click"
                        Content="Skip" />
            </Grid>
            <Button Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,6"
                    ToolTip="Reset the current session (Ctrl+Alt+R)"
                    Click="ResetButton_Click"
                    Content="Reset" />
        </StackPanel>
    </Grid>
</Window>
